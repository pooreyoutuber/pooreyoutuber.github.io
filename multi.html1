<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{"@type":"SoftwareApplication","name":"Video Compressor","applicationCategory":"MultimediaApplication","operatingSystem":"Any (Web Browser)","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"description":"Free browser-based video compressor with custom target size in MB or GB."},
{"@type":"HowTo","name":"How to compress a video online","step":[{"@type":"HowToStep","text":"Upload your video file."},{"@type":"HowToStep","text":"Check the original size shown."},{"@type":"HowToStep","text":"Enter the target size in MB or GB."},{"@type":"HowToStep","text":"Click Compress, then Download."}]},
{"@type":"FAQPage","mainEntity":[
{"@type":"Question","name":"Is this video compressor free?","acceptedAnswer":{"@type":"Answer","text":"Yes. It is completely free with no sign-up, watermark or file limit set by the tool."}},
{"@type":"Question","name":"Are my videos uploaded to a server?","acceptedAnswer":{"@type":"Answer","text":"No. Compression happens locally in your browser, so your video stays private."}},
{"@type":"Question","name":"Can I choose the exact output size?","acceptedAnswer":{"@type":"Answer","text":"Yes. Enter a target in MB or GB. The result is very close to it, usually slightly smaller."}},
{"@type":"Question","name":"Why does compression take as long as the video?","acceptedAnswer":{"@type":"Answer","text":"The video is re-encoded in real time by your browser, so keep the tab open until it finishes."}}]}]}
</script>
<style>
:root{--bg:#0e1116;--card:#171c24;--line:#2a3140;--tx:#e8ecf3;--mu:#97a1b3;--ac:#2fd4a7;--ac2:#4c8dff}
*{box-sizing:border-box}
body{margin:0;font:16px/1.7 "Segoe UI",system-ui,Arial,sans-serif;background:radial-gradient(1200px 500px at 50% -10%,#1b2a3f,var(--bg));color:var(--tx)}
header{text-align:center;padding:48px 16px 8px}
h1{font-size:clamp(28px,5vw,44px);margin:0 0 10px;line-height:1.2}
header p{color:var(--mu);max-width:640px;margin:0 auto}
main{max-width:760px;margin:24px auto;padding:0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 20px 50px rgba(0,0,0,.35)}
#drop{border:2px dashed var(--line);border-radius:14px;padding:36px 16px;text-align:center;cursor:pointer;transition:.2s}
#drop:hover,#drop.on,#drop:focus{border-color:var(--ac);background:#1a2430;outline:none}
#drop b{display:block;font-size:18px}#drop span{color:var(--mu);font-size:14px}
.ico{font-size:40px}
#panel{display:none;margin-top:20px}
video{width:100%;max-height:260px;border-radius:12px;background:#000}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0}
.stat{background:#10141b;border:1px solid var(--line);border-radius:12px;padding:12px;text-align:center}
.stat small{color:var(--mu);display:block;font-size:12px}.stat strong{font-size:17px;word-break:break-all}
#orig{color:var(--ac)}
label{font-weight:600;display:block;margin-bottom:6px}
.row{display:flex;gap:10px}
input,select{background:#10141b;color:var(--tx);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:16px}
input{flex:1;min-width:0}
input:focus,select:focus,button:focus-visible{outline:2px solid var(--ac2);outline-offset:2px}
button{width:100%;margin-top:14px;padding:14px;border:0;border-radius:12px;font-size:17px;font-weight:700;cursor:pointer;color:#06231b;background:linear-gradient(90deg,var(--ac),#7be8c8)}
button:disabled{opacity:.5;cursor:not-allowed}
#dl{display:none;background:linear-gradient(90deg,var(--ac2),#8ab4ff);color:#fff}
.bar{height:10px;background:#10141b;border-radius:99px;overflow:hidden;margin-top:14px;display:none}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--ac),var(--ac2));transition:width .3s}
#msg{margin-top:12px;color:var(--mu);font-size:14px;min-height:20px}
#msg.err{color:#ff8a8a}
article{margin-top:40px;color:#c9d1de}
article h2{font-size:26px;margin:34px 0 8px;color:var(--tx)}
article h3{font-size:19px;margin:22px 0 4px;color:var(--ac)}
article li{margin-bottom:6px}
details{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 16px;margin:8px 0}
summary{cursor:pointer;font-weight:600}
footer{text-align:center;color:var(--mu);font-size:13px;padding:30px 16px}
@media(max-width:520px){.stats{grid-template-columns:1fr}}
</style>
</head>
<body>
<header>
<h1>Free Online Video Compressor</h1>
<p>Upload a video, see its real size, type the size you want in MB or GB, and download. No sign-up. No server upload.</p>
</header>
<main>
<section class="card" aria-label="Video compressor tool">
<div id="drop" tabindex="0" role="button" aria-label="Choose a video file">
<div class="ico">🎬</div><b>Click or drop your video here</b><span>MP4, MOV, WebM, MKV, AVI and more (browser-supported formats)</span>
<input type="file" id="file" accept="video/*" hidden>
</div>
<div id="panel">
<video id="pv" controls muted playsinline></video>
<div class="stats">
<div class="stat"><small>Original size</small><strong id="orig">–</strong></div>
<div class="stat"><small>Duration</small><strong id="dur">–</strong></div>
<div class="stat"><small>Resolution</small><strong id="res">–</strong></div>
</div>
<label for="tv">Target size</label>
<div class="row">
<input type="number" id="tv" min="0.1" step="any" placeholder="e.g. 20">
<select id="tu" aria-label="Unit"><option>MB</option><option>GB</option></select>
</div>
<button id="go">Compress video</button>
<div class="bar" id="bar"><i id="fill"></i></div>
<div id="msg"></div>
<div class="stats" id="out" style="display:none">
<div class="stat"><small>New size</small><strong id="ns">–</strong></div>
<div class="stat"><small>Saved</small><strong id="sv">–</strong></div>
<div class="stat"><small>Format</small><strong id="fm">–</strong></div>
</div>
<button id="dl">Download compressed video</button>
</div>
</section>

<article>
<h2>Compress Video Online to Any Size You Want</h2>
<p>Large video files are hard to share. Email services reject attachments above 25 MB, messaging apps limit uploads, and cloud storage fills up quickly. This free online video compressor solves the problem in a simple way: you upload a video, the tool shows its exact original size, and you decide how big the final file should be. Enter a number in megabytes or gigabytes, press one button, and download the result. Everything runs inside your own browser, so your footage is never sent to a server.</p>

<h2>How to Use the Video Compressor</h2>
<ol>
<li><strong>Upload your video.</strong> Click the upload box or drag a file onto it. The tool instantly displays the original file size, duration and resolution.</li>
<li><strong>Enter the size you need.</strong> Type a value in the target size box and choose MB or GB. For example, type 20 and select MB to get a file of about 20 MB.</li>
<li><strong>Click Compress video.</strong> The video is re-encoded in your browser. A progress bar shows how far along it is. Keep the tab open and visible until it reaches 100%.</li>
<li><strong>Download.</strong> When finished, the new size and the amount saved appear. Click the download button to save the compressed file.</li>
</ol>

<h2>Key Benefits</h2>
<h3>You control the final size</h3>
<p>Most compressors give only vague options such as low, medium or high quality. Here you choose the exact target, which is useful when a platform has a strict limit like 8 MB, 25 MB or 100 MB.</p>
<h3>Private by design</h3>
<p>Your video never leaves your device. There is no upload, no waiting for a server queue, and no risk of personal clips being stored by a third party. This makes the tool suitable for family videos, work recordings and confidential material.</p>
<h3>Free, with no watermark</h3>
<p>There are no accounts, subscriptions or logos burned into your video. Use the tool as often as you like.</p>
<h3>Works on any modern device</h3>
<p>The compressor runs in Chrome, Edge, Firefox and Safari on desktop and many mobile devices. Nothing needs to be installed.</p>
<h3>Smart quality balance</h3>
<p>The tool calculates the bitrate needed to reach your target size. If the target is very small, it also reduces the resolution so the picture stays clean instead of turning blocky.</p>

<h2>When Should You Compress a Video?</h2>
<ul>
<li>Sending clips by email, WhatsApp, Telegram or Slack.</li>
<li>Uploading assignments, application videos or portfolio reels to sites with size limits.</li>
<li>Saving phone storage by shrinking old recordings.</li>
<li>Making website videos load faster, which improves user experience and SEO.</li>
<li>Reducing mobile data use when sharing videos on slow connections.</li>
</ul>

<h2>Tips for the Best Results</h2>
<ul>
<li>Choose a realistic target. Shrinking a 1 GB video to 5 MB will cause visible quality loss.</li>
<li>Keep the browser tab active while compressing, because background tabs can be slowed down.</li>
<li>Compression time is roughly equal to the video length, since the browser processes it in real time.</li>
<li>If your target is larger than the original, the tool will warn you, as compression cannot add quality.</li>
</ul>

<h2>Frequently Asked Questions</h2>
<details><summary>Is this video compressor free?</summary><p>Yes. It is completely free, with no sign-up and no watermark.</p></details>
<details><summary>Is my video uploaded anywhere?</summary><p>No. All processing happens locally in your browser, so your file stays private.</p></details>
<details><summary>How accurate is the target size?</summary><p>The result is usually within a few percent of your target and normally slightly smaller, because the tool leaves a safety margin for container overhead.</p></details>
<details><summary>Which format will the output be?</summary><p>The tool uses MP4 when your browser supports it, otherwise WebM. Both play on almost all devices and platforms.</p></details>
<details><summary>Why is compression taking so long?</summary><p>The video is encoded in real time, so a 10-minute video needs about 10 minutes. Keep the tab open.</p></details>
</article>
</main>
<footer>© Free Video Compressor – compress video online to MB or GB, privately in your browser.</footer>

<script>
const $=id=>document.getElementById(id);
let src=null,url=null,outBlob=null,meta={};
const fmt=b=>b>=1073741824?(b/1073741824).toFixed(2)+" GB":b>=1048576?(b/1048576).toFixed(2)+" MB":(b/1024).toFixed(1)+" KB";
const tm=s=>{s=Math.round(s);return Math.floor(s/60)+":"+String(s%60).padStart(2,"0")};
const say=(t,e)=>{$("msg").textContent=t;$("msg").className=e?"err":""};
const drop=$("drop");
drop.onclick=()=>$("file").click();
drop.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();$("file").click()}};
["dragover","dragenter"].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.add("on")}));
["dragleave","drop"].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.remove("on")}));
drop.addEventListener("drop",e=>load(e.dataTransfer.files[0]));
$("file").onchange=e=>load(e.target.files[0]);
function load(f){
 if(!f)return;
 if(!f.type.startsWith("video/")){say("Please choose a valid video file.",1);$("panel").style.display="block";return}
 src=f;outBlob=null;if(url)URL.revokeObjectURL(url);url=URL.createObjectURL(f);
 const v=$("pv");v.src=url;
 v.onloadedmetadata=()=>{meta={d:v.duration,w:v.videoWidth,h:v.videoHeight};
  $("orig").textContent=fmt(f.size);$("dur").textContent=tm(meta.d);$("res").textContent=meta.w+"×"+meta.h;
  $("panel").style.display="block";$("dl").style.display="none";$("out").style.display="none";$("bar").style.display="none";
  say("Enter the size you want and click Compress.")};
 v.onerror=()=>{say("This video format cannot be read by your browser. Try MP4 or WebM.",1);$("panel").style.display="block"};
}
$("go").onclick=async()=>{
 const val=parseFloat($("tv").value);
 if(!src)return say("Upload a video first.",1);
 if(!val||val<=0)return say("Enter a valid target size.",1);
 const target=val*($("tu").value==="GB"?1073741824:1048576);
 if(target>=src.size)return say("Target is not smaller than the original ("+fmt(src.size)+"). Enter a smaller size.",1);
 const total=target*0.97*8,audio=meta.d>0?(total/meta.d>200000?96000:48000):96000;
 let vb=total/meta.d-audio;
 if(vb<60000)return say("Target is too small for this video's length. Enter a larger size.",1);
 const fps=30,bpp=0.07,pix=vb/(fps*bpp);
 let sc=Math.min(1,Math.sqrt(pix/(meta.w*meta.h)));sc=Math.max(sc,0.15);
 const W=Math.max(2,Math.round(meta.w*sc/2)*2),H=Math.max(2,Math.round(meta.h*sc/2)*2);
 const types=["video/mp4;codecs=avc1.42E01E,mp4a.40.2","video/mp4","video/webm;codecs=vp9,opus","video/webm;codecs=vp8,opus","video/webm"];
 const mime=types.find(t=>window.MediaRecorder&&MediaRecorder.isTypeSupported(t));
 if(!mime)return say("Your browser does not support video compression. Use latest Chrome, Edge or Firefox.",1);
 $("go").disabled=true;$("dl").style.display="none";$("out").style.display="none";$("bar").style.display="block";$("fill").style.width="0";
 say("Compressing… keep this tab open.");
 try{
  const encode=async(vbr,label)=>{
   say(label+" Keep this tab open.");$("fill").style.width="0";
   const v=document.createElement("video");v.src=url;v.playsInline=true;v.preload="auto";
   await new Promise((r,j)=>{v.onloadeddata=r;v.onerror=j});
   const cv=document.createElement("canvas");cv.width=W;cv.height=H;const cx=cv.getContext("2d");
   const stream=cv.captureStream(fps);
   try{const ac=new (window.AudioContext||window.webkitAudioContext)();const s=ac.createMediaElementSource(v);const d=ac.createMediaStreamDestination();s.connect(d);
    d.stream.getAudioTracks().forEach(t=>stream.addTrack(t));}catch(e){}
   const rec=new MediaRecorder(stream,{mimeType:mime,videoBitsPerSecond:Math.round(vbr),audioBitsPerSecond:audio});
   const ch=[];rec.ondataavailable=e=>{if(e.data.size)ch.push(e.data)};
   const done=new Promise(r=>rec.onstop=r);
   rec.start(1000);
   let run=true;
   const draw=()=>{if(!run)return;cx.drawImage(v,0,0,W,H);$("fill").style.width=Math.min(99,v.currentTime/meta.d*100)+"%";
    v.requestVideoFrameCallback?v.requestVideoFrameCallback(draw):requestAnimationFrame(draw)};
   v.onended=()=>{run=false;setTimeout(()=>rec.stop(),300)};
   await v.play();draw();await done;
   return new Blob(ch,{type:mime.split(";")[0]});
  };
  let best=null,cur=vb;
  for(let p=1;p<=3;p++){
   const b=await encode(cur,"Pass "+p+" of up to 3: matching your target size…");
   if(b.size<=target&&(!best||b.size>best.size))best=b;
   if(b.size<=target&&b.size>=target*0.9)break;
   if(p===3)break;
   const f=Math.min(4,Math.max(0.3,(target*0.96-audio*meta.d/8)/Math.max(1,b.size-audio*meta.d/8)));
   cur=cur*f;
   if(cur<40000)break;
  }
  outBlob=best||await encode(cur*0.8,"Final pass…");
  $("fill").style.width="100%";
  $("ns").textContent=fmt(outBlob.size);
  $("sv").textContent=Math.max(0,(1-outBlob.size/src.size)*100).toFixed(0)+"%";
  $("fm").textContent=mime.includes("mp4")?"MP4":"WebM";
  $("out").style.display="grid";$("dl").style.display="block";
  say(outBlob.size>src.size?"Output is larger than the original. Try a smaller target.":"Done! Your video is ready to download.",outBlob.size>src.size);
 }catch(e){say("Compression failed. Try another video or browser.",1)}
 $("go").disabled=false;
};
$("dl").onclick=()=>{
 if(!outBlob)return;
 const a=document.createElement("a");a.href=URL.createObjectURL(outBlob);
 const ext=outBlob.type.includes("mp4")?"mp4":"webm";
 a.download=src.name.replace(/\.[^.]+$/,"")+"-compressed."+ext;
 document.body.appendChild(a);a.click();a.remove();
};
</script>
</body>
</html>
