        const DARK_TEXT = '☀️ Light Mode';
        const currentMode = localStorage.getItem('theme') || 'light-mode';
        if (currentMode === 'dark-mode') {
            body.classList.add('dark-mode');
            toggle.textContent = DARK_TEXT;
        } else {
            body.classList.remove('dark-mode');
            toggle.textContent = LIGHT_TEXT;
        }
        function toggleDarkMode() {
            if (body.classList.contains('dark-mode')) {
                body.classList.remove('dark-mode');
                localStorage.setItem('theme', 'light-mode');
                toggle.textContent = LIGHT_TEXT;
            } else {
                body.classList.add('dark-mode');
                localStorage.setItem('theme', 'dark-mode');
                toggle.textContent = DARK_TEXT;
            }
        }

        let activeFilter = 'all';
        const searchInput = document.getElementById('topicSearch');
        const folderGrid = document.getElementById('folderGrid');
        const searchPanel = document.getElementById('searchResults');
        const searchGrid = document.getElementById('searchGrid');
        const toolsSection = document.getElementById('tools');
        const folderPanels = document.querySelectorAll('.folder-panel[data-folder]');

        function catOk(cats) { return activeFilter === 'all' || (cats || '').includes(activeFilter); }
        function textOf(el) { return ((el.getAttribute('data-search') || '') + ' ' + el.textContent).toLowerCase(); }
        function currentFolderId() {
            const h = location.hash.slice(1);
            return (h.indexOf('folder-') === 0 && document.getElementById(h)) ? h : null;
        }

        function applyFilters() {
            const q = searchInput.value.trim().toLowerCase();
            let visible = 0;

            document.querySelectorAll('.course').forEach(item => {
                const show = catOk(item.getAttribute('data-category')) && (!q || textOf(item).includes(q));
                item.style.display = show ? 'flex' : 'none';
                if (show) visible++;
            });

            const fid = q ? null : currentFolderId();
            let folderVisible = 0;
            document.querySelectorAll('.folder').forEach(f => {
                const show = catOk(f.getAttribute('data-category'));
                f.style.display = show ? 'flex' : 'none';
                if (show) folderVisible++;
            });

            searchGrid.innerHTML = '';
            let hits = 0;
            if (q) {
                document.querySelectorAll('.folder-panel[data-folder] .tool').forEach(t => {
                    if (catOk(t.getAttribute('data-category')) && textOf(t).includes(q)) {
                        searchGrid.appendChild(t.cloneNode(true));
                        hits++;
                    }
                });
            }
            searchPanel.hidden = !(q && hits > 0);
            folderPanels.forEach(p => { p.hidden = (p.id !== fid); });
            folderGrid.hidden = !!q || !!fid;

            const toolsVisible = q ? hits > 0 : (fid ? true : folderVisible > 0);
            toolsSection.style.display = toolsVisible ? '' : 'none';
            visible += q ? hits : (fid ? 1 : folderVisible);

            const exploreSec = document.getElementById('explore');
            if (exploreSec) {
                const any = [...exploreSec.querySelectorAll('.course')].some(c => c.style.display !== 'none');
                exploreSec.style.display = any ? '' : 'none';
            }

            document.getElementById('noResults').style.display = visible ? 'none' : 'block';
            return fid;
        }

        function filterCategory(cat, btn) {
            activeFilter = cat;
            document.querySelectorAll('.filter-chip').forEach(c => {
                c.classList.remove('active');
                c.setAttribute('aria-pressed', 'false');
            });
            if (btn) { btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true'); }
            if (currentFolderId()) {
                history.replaceState(null, '', location.pathname + location.search + '#tools');
            }
            applyFilters();
        }

        document.querySelectorAll('.filter-chip').forEach(chip => {
            chip.addEventListener('click', () => filterCategory(chip.dataset.filter, chip));
        });
        searchInput.addEventListener('input', applyFilters);
        window.addEventListener('hashchange', () => {
            const fid = applyFilters();
            if (fid) toolsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        const qp = new URLSearchParams(location.search).get('q');
        if (qp) searchInput.value = qp;
        const startFolder = applyFilters();
        if (startFolder) toolsSection.scrollIntoView({ block: 'start' });
    </script>
</body>
</html>
